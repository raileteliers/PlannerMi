# Copy to .env.local and fill in from the Supabase project (Settings → API).
#
# Both end up verbatim in the bundle — that is what EXPO_PUBLIC_ means, and it
# is fine: the anon key identifies the project, it does not grant anything.
# What separates one person's data from another is row level security, in
# supabase/migrations/0001_records.sql.
#
# The service_role key is the one that must never be here.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
