# Local secrets. `*.local` above already covers .env.local; .env is spelled
# out so a stray one cannot be committed either.
.env
.env.*
!.env.example

# Data backups. `Exportar JSON` writes plannermi-YYYY-MM-DD.json and it holds
# real ramos, evaluaciones and tareas. This repo is public: one of these
# committed by accident is personal data published to the world.
plannermi-*.json

