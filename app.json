{
  "expo": {
    "name": "PlannerMi",
    "slug": "plannermi",
    "version": "1.0.0",
    "scheme": "plannermi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "android": {
      "package": "com.plannermi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.plannermi.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00bad216-c8e8-423a-aa8f-4efa2cea76f0"
      }
    },
    "owner": "raileteliers"
  }
}
